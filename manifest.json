{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.37.0",
  "description": "网易邮箱网页版草稿工作台：以独立结构证据区分邮件、参考总名单与附件，冲突资料停止自动分流并支持导入时纠正；只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
