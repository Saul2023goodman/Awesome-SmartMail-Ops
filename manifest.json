{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.29.0",
  "description": "网易邮箱网页版草稿工作台：批量审阅采用稳定 Review Canvas，邮件列表可搜索/顺序浏览，正文不被悬浮操作遮挡；排除等低频危险操作收进上下文菜单，只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
