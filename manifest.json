{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.40.0",
  "description": "网易邮箱网页版邮件工作台：强化中文邮件/附件来源分类，支持手动附件直接发送、参考总名单核验、同校优先级排程与节假日/周末避让。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
