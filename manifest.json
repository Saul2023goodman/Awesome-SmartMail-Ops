{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.44.0",
  "description": "网易邮箱网页版邮件工作台：上传后以“看内容→确认用途→继续”为核心核验文件分类；减少重复字段与操作，放大关键信息，右侧仅保留内容预览和一个用途选择器，并支持目录定位与拖拽快速归类。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
