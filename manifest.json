{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.27.0",
  "description": "网易邮箱网页版草稿工作台：支持批量解析、重复邮件组级取舍、选择与排程；重复项可保留任意子集或明确全部保留，只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
