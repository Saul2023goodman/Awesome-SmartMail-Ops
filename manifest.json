{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "0.6.0",
  "description": "网易邮箱网页版桌面级外联工作台：单封/批量草稿、智能导入、附件中心、标签筛选编辑、联系人状态与已发送历史；不会自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "importer.js",
        "contacts.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
