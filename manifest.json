{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "2.3.0",
  "description": "独立 Chrome 工作台：压缩固定导航与顶栏，按任务画布拆分导入、核验、排期规则、邮件时间与草稿创建；仅内容区按需滚动。",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "action": {
    "default_title": "打开网易邮箱外联工作台"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "executor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
