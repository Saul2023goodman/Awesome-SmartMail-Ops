{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.19.0",
  "description": "网易邮箱网页版草稿工作台：确定性问题补齐后自动通过，最后一个待办完成后自动进入选择与安排；邮件检查以最终可编辑内容为主，解析依据按需展开。只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
