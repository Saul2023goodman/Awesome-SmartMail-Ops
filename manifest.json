{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "0.2.0",
  "description": "网易邮箱网页版单封/批量草稿助手：识别 XLSX/CSV/TSV/JSON，填写收件人、主题、正文、附件和定时发送设置；不会自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "importer.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
