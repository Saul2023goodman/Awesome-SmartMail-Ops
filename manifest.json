{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "0.7.0",
  "description": "网易邮箱网页版外联工作台：统一联系人分类（互动阶段/跟进/发送策略/标签）、批量筛选与安全拦截、草稿、附件、已发送历史；不会自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "importer.js",
        "contacts.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
