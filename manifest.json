{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.12.0",
  "description": "网易邮箱网页版外联工作台：按“添加资料 → 核对邮件 → 选择与定时 → 创建草稿”的清晰流程完成批量外联准备；支持多格式导入、总名单核对、异常校正、学校级定时安排、联系人与邮箱历史维护。只创建并确认保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
