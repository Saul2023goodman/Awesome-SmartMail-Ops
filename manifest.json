{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.18.0",
  "description": "网易邮箱网页版草稿工作台：导入资料后按当前未解决事项自动路由，补齐确定性字段后自动通过，缺附件明确提示并引导添加，时间统一在排程阶段处理。只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
