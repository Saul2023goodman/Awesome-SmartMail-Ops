{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.33.0",
  "description": "网易邮箱网页版草稿工作台：先导入邮件资料，随后通过批次准备弹窗集中补充参考总名单与附件；附件始终保留业务入口，后续按待办处理；支持并排决策，只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
