{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.30.0",
  "description": "网易邮箱网页版草稿工作台：审阅页直接提供核心排除操作，重复邮件支持多篇并排预览与多选保留；用户主流程不展示解析证据，只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
