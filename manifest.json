{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.20.0",
  "description": "网易邮箱网页版草稿工作台：统一识别正文、签名、附言与来源/附件/定时等非正文边界，防止说明内容侵入草稿；只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
