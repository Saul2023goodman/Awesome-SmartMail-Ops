{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "2.4.0",
  "description": "独立 Chrome 工作台：主页面负责总览与选择，复杂审阅、排期设置和联系人编辑通过任务弹窗完成；列表空间优先。",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "action": {
    "default_title": "打开网易邮箱外联工作台"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "executor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
