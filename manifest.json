{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "0.9.0",
  "description": "网易邮箱网页版外联工作台：统一联系人分类、已发送/草稿箱历史同步、扩展读取范围、全文检索、定时时间可视化、批量草稿与附件；不会自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "importer.js",
        "contacts.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
