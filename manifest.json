{
  "manifest_version": 3,
  "name": "SmartMail Ops",
  "version": "3.8.57",
  "description": "SmartMail Ops — preserves authored mail formatting and surfaces italic/quotation attention signals during review without altering outbound content.",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "action": {
    "default_title": "打开 SmartMail Ops"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "executor.js",
        "mail-dock.js"
      ],
      "run_at": "document_idle",
      "css": [
        "mail-dock.css"
      ]
    }
  ],
  "key": ""
}
