{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.13.0",
  "description": "网易邮箱网页版外联工作台：以单一批量业务链完成资料准备、必要核对、任务选择、定时与草稿创建；联系人页负责长期状态与邮箱同步。只创建并确认保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
