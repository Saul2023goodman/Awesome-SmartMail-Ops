{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.7.0",
  "description": "网易邮箱网页版外联工作台：邮件原语识别、异常校正、批量草稿、联系人，以及可快速刷新/完整重建的邮箱状态读取；只创建并确认保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}