{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.47.0",
  "description": "网易邮箱网页版邮件工作台：将分类核验列表改为决策型快速摘要；名单识别新增文件名意图与表格结构互证，并对多工作表采用高置信来源共识，减少明确名单误进待确认。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
