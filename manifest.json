{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.34.0",
  "description": "网易邮箱网页版草稿工作台：邮件导入后通过批次准备补充参考总名单与附件；附件作为可持续管理的批次资产库，在导入、待办与创建前均可查看、增删和重新匹配；只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
