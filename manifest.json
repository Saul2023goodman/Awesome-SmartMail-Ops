{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.36.0",
  "description": "网易邮箱网页版草稿工作台：默认纳入全部可创建邮件，将检索降级为例外筛选，并以明确发送义务识别附件需求；只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
