{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "0.8.0",
  "description": "网易邮箱网页版外联工作台：统一联系人/任务分类、全文检索、明确执行范围、定时时间可视化、批量草稿、附件与已发送历史；不会自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "importer.js",
        "contacts.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
