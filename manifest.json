{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.3.0",
  "description": "网易邮箱网页版外联工作台：独立导入工作台 + Universal Import Engine + Word/表格/ZIP 多格式识别，批量任务、联系人、附件与定时；只创建并确认保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
