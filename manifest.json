{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "2.7.0",
  "description": "独立 Chrome 工作台：邮件审阅按异常类型直接进入正确操作。确定性缺失字段点击邮件即直接补齐；重复邮件合并为版本堆叠卡并集中比较取舍；普通邮件保持完整只读审阅，重点核对开头、结尾与边界。",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "action": {
    "default_title": "打开网易邮箱外联工作台"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "executor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}