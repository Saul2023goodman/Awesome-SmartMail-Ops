{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.0.0",
  "description": "网易邮箱网页版外联工作台：简化后的任务选择逻辑、统一联系人分类、已发送/草稿箱历史同步、批量草稿、附件与定时；只创建草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "importer.js",
        "contacts.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
