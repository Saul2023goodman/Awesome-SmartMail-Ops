{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.45.0",
  "description": "网易邮箱网页版邮件工作台：修复批量 Word 单文件预览串内容问题，执行集合与单文件核验来源隔离；强化 DOCX/XLSX/PDF 等文件类型图标和邮件/总名单/附件用途视觉区分。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
