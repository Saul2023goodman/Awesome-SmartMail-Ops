{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "0.4.0",
  "description": "网易邮箱网页版批量草稿与联系人助手：智能导入、附件匹配、定时草稿、读取已发送并维护联系人状态；不会自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "importer.js",
        "contacts.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
