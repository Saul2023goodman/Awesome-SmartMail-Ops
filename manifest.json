{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.14.0",
  "description": "网易邮箱网页版外联工作台：独立逐条确认质量门，支持选择后批量补主题与批量确认；右侧固定竖向流程贯穿资料、确认、选择、排程和草稿创建。只创建并确认保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
