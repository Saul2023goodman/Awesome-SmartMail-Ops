{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.35.0",
  "description": "网易邮箱网页版草稿工作台：单一滚动工作区、右侧创建草稿操作与复杂总名单院校补全；支持纵向合并单元格、层级空白继承及多证据联系人匹配；只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
