{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.41.0",
  "description": "网易邮箱网页版邮件工作台：上传后先核验自动资料分类，保留原目录树并支持单文件纠错，同时支持批次附件、参考总名单、同校优先级排程与节假日避让。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
