{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.43.0",
  "description": "网易邮箱网页版邮件工作台：上传后以文件证据为中心核验自动分类，列表直接展示内容摘要与判断说明，右侧统一修改用途，拖拽归类仅在拖动时出现，并继续支持目录定位、总名单、附件和自动排期。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
