{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "0.3.0",
  "description": "网易邮箱网页版单封/批量草稿助手：智能识别任务表，统一管理公共/专属附件，填写收件人、主题、正文和定时设置；不会自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "importer.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
