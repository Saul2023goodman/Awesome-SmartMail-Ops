{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.42.0",
  "description": "网易邮箱网页版邮件工作台：上传后进入文件分类核验工作区，支持目录定位、拖拽重归类、单文件就地预览与快速修正，并继续支持批次附件、参考总名单和自动排期。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
