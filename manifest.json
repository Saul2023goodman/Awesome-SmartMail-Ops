{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.17.0",
  "description": "网易邮箱网页版外联工作台：批量导入后完整检查解析邮件，选择并默认展开自动安排时间，再统一创建草稿；填写单篇主题后可顺势一键补齐其他空白主题。只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
