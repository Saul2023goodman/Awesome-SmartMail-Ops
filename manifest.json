{
  "manifest_version": 3,
  "name": "NetEase Mail Draft Assistant",
  "version": "1.32.0",
  "description": "网易邮箱网页版草稿工作台：导入后按业务优先级突出当前待办，附件缺失直接进入一级处理；参考总名单保持轻量增强，导入详情按需展开；支持并排决策，只保存草稿，不自动发送。",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "import-core.js",
        "mail-recognizer.js",
        "import-adapters.js",
        "importer.js",
        "contacts.js",
        "scheduler.js",
        "roster.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
