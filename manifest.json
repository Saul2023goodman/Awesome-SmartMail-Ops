{
  "manifest_version": 3,
  "name": "网易邮箱外联工作台",
  "version": "4.0.0",
  "description": "可视化外联工作台：资料拖拽分类、邮件核验、统一附件匹配、时间轴排期与网易草稿批量创建。",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://mail.163.com/*"
  ],
  "action": {
    "default_title": "打开网易邮箱外联工作台"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.163.com/*"
      ],
      "js": [
        "executor.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
